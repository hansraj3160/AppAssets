{
  "name": "appassets",
  "version": "0.3.1",
  "description": "App Store screenshot and preview automation driven by argent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hansraj3160/AppAssets.git"
  },
  "homepage": "https://appassetstudio.com",
  "keywords": [
    "app-store",
    "screenshots",
    "app-preview",
    "ios",
    "simulator",
    "argent",
    "android",
    "google-play",
    "claude-skill"
  ],
  "type": "module",
  "bin": {
    "appassets": "dist/cli.js",
    "goldie": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "assets/17-pro-*.png",
    "assets/pixel-10-pro.webp",
    "assets/ipad-13.png",
    "assets/ATTRIBUTION.md",
    "assets/fonts/",
    "studio/dist/",
    "skills/",
    "appassets.config.example.ts"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "workspaces": [
    "studio"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/cli.ts manifest && npm run dev --workspace=appassets-studio",
    "start": "node dist/cli.js studio --no-open --port 3000 --host 0.0.0.0",
    "appassets": "node src/cli.ts",
    "goldie": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "capture": "node src/cli.ts capture",
    "import": "node scripts/import-images.js",
    "frame": "node src/cli.ts frame",
    "preview": "node src/cli.ts preview",
    "all": "node src/cli.ts all",
    "studio": "node src/cli.ts manifest && npm run dev --workspace=appassets-studio",
    "studio:build": "npm run build:studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "test": "npm run test:backend && npm run test:studio",
    "test:backend": "bun test",
    "test:studio": "npm run test --workspace=appassets-studio",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && npm exec --workspace=appassets-studio -- tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run build",
    "build": "npm run build:studio && npm run build:cli",
    "build:cli": "rm -rf dist && esbuild src/cli.ts src/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --sourcemap=linked && tsc -p tsconfig.build.json",
    "build:studio": "npm run build --workspace=appassets-studio",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@swmansion/argent": "^0.22.0",
    "jiti": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.2"
  }
}
