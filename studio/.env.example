# AppAssets Studio (Client) Environment Variables Template
# Copy this file to studio/.env to configure client environment

# Google Analytics 4 (GA4) Measurement ID
# Both NEXT_PUBLIC_ and VITE_ prefixes are supported
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense (Optional)
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SIDEBAR_SLOT=XXXXXXXXXX
VITE_ADSENSE_BOTTOM_SLOT=XXXXXXXXXX
