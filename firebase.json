{
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "AppAssets Studio",
        "supportEmail": "rajh8157@gmail.com"
      },
      "emailPassword": true
    },
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "appassets-studio.firebaseapp.com",
      "appassets-studio.web.app",
      "appassetstudio.com",
      "www.appassetstudio.com"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "firebase-cdn",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
